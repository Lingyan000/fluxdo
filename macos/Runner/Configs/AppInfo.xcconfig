// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = fluxdo

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.github.lingyan000.fluxdo

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 FluxDO. All rights reserved.

// Keep macOS target version metadata aligned with Flutter build metadata.
MARKETING_VERSION = $(FLUTTER_BUILD_NAME)
CURRENT_PROJECT_VERSION = $(FLUTTER_BUILD_NUMBER)

// Apple 签名默认值：adhoc 签名（无需 Apple Team / 证书），保证 fresh checkout
// 与无 secrets 的 CI 都能直接构建，且走完 codesign 步骤把 entitlements 注入 .app。
// 有稳定签名身份（自签证书 / Apple Development）时在 apple/Local.xcconfig 中覆盖，
// 可消除每次 rebuild 后钥匙串（flutter_secure_storage）反复弹窗的问题。
FLUXDO_APPLE_CODE_SIGN_IDENTITY_MACOSX = -
FLUXDO_APPLE_CODE_SIGN_STYLE = Manual
FLUXDO_APPLE_CODE_SIGNING_ALLOWED = YES

#include? "../../../apple/Local.xcconfig"
