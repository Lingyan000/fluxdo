    Label(text: data.statusNote, color: "onSurfaceVariant"), Gap(size: 24),
    Surface(child: Column(crossAxisAlignment: "stretch", children: [
      ProductSummary(image: data.orderImage, loading: data.orderImageLoading, title: data.orderTitle, subtitle: data.quantity), Gap(size: 20),
      ...for row in data.fields: Padding(padding: [0.0, 5.0, 0.0, 5.0], child: DetailRow(label: row.label, value: row.value)),
    ])),
    switch data.hasDelivery {true: Padding(padding: [0.0, 20.0, 0.0, 0.0], child: Surface(child: Column(crossAxisAlignment: "stretch", children: [
      Row(children: [Expanded(child: SectionTitle(title: "发货内容")), Button(label: data.deliveryAction, icon: "visibility", variant: "text", onPressed: event "delivery" {})]),
      switch data.deliveryText {"": Label(text: "内容已隐藏，点击查看", style: "bodySmall", color: "onSurfaceVariant"), default: Column(crossAxisAlignment: "stretch", children: [Gap(size: 12), SelectableLabel(text: data.deliveryText), CopyButton(text: data.deliveryText, label: "复制全部发货内容")])},
    ]))), default: SizedBoxShrink()},
    switch data.usage {"": SizedBoxShrink(), default: Padding(padding: [0.0, 20.0, 0.0, 0.0], child: Column(crossAxisAlignment: "stretch", children: [SectionTitle(title: "使用说明"), Gap(size: 12), Markdown(text: data.usage, onLink: event "contentLink" {})]))},
    Gap(size: 24), SectionTitle(title: "订单信息"), Gap(size: 12),
    Surface(child: Column(crossAxisAlignment: "stretch", children: [
      DetailRow(label: "交付方式", value: data.delivery), Gap(size: 12), Label(text: "订单号", style: "labelMedium", color: "onSurfaceVariant"),
      Row(children: [Expanded(child: SelectableLabel(text: data.orderNo)), CopyButton(text: data.orderNo)]),
      switch data.tradeNo {"": SizedBoxShrink(), default: Column(crossAxisAlignment: "stretch", children: [Label(text: "Credit 交易号", style: "labelMedium", color: "onSurfaceVariant"), SelectableLabel(text: data.tradeNo), Gap(size: 12)])},
      ...for row in data.times: Padding(padding: [0.0, 5.0, 0.0, 5.0], child: DetailRow(label: row.label, value: row.value)),
    ])),
    Gap(size: 24), SectionTitle(title: "订单动态"), Gap(size: 12),
    ...for entry in data.orderEvents: TimelineEntry(entry: entry),
    Label(text: data.paymentNote, color: "error"),
    switch data.canCheck {true: Button(label: "检查支付状态", loading: data.paymentBusy, icon: "sync", variant: "tonal", onPressed: event "checkPayment" {}), default: SizedBoxShrink()},
  ]), default: SizedBoxShrink()}, OrderFeedback(),
]);
widget TimelineEntry = Padding(padding: [0.0, 0.0, 0.0, 16.0], child: Row(crossAxisAlignment: "start", children: [
  Symbol(name: "check_circle", size: 18.0, color: "onSurfaceVariant"), Gap(size: 12), Expanded(child: Column(crossAxisAlignment: "stretch", children: [
    Label(text: args.entry.title, style: "titleSmall"), Gap(size: 4), Label(text: args.entry.time, style: "bodySmall", color: "onSurfaceVariant"),
    switch args.entry.message {"": SizedBoxShrink(), default: Padding(padding: [0.0, 6.0, 0.0, 0.0], child: Label(text: args.entry.message))},
  ])),
]));
widget DetailRow = Row(crossAxisAlignment: "start", children: [
  Expanded(child: Label(text: args.label, color: "onSurfaceVariant")), Gap(size: 16),
  Expanded(flex: 2, child: Label(text: args.value, align: "end", style: "bodyMedium")),
]);
widget OrderFeedback = switch data.error {"": SizedBoxShrink(), default: EmptyState(icon: "history", title: data.error, action: switch data.needsSession {
  true: LoginButton(), default: Button(label: "重新读取订单", variant: "outlined", onPressed: event "ordersRefresh" {}),
})};
widget ExternalFeedback = switch data.externalError {"": SizedBoxShrink(), default: Padding(padding: [0.0, 0.0, 0.0, 8.0], child: Label(text: data.externalError, color: "error"))};
widget LoginButton = switch data.authorized {true: SizedBoxShrink(), default: Column(mainAxisSize: "min", crossAxisAlignment: "stretch", children: [
  Button(label: "登录士多", icon: "person", variant: "tonal", loading: data.loggingIn, onPressed: event "login" {}),
