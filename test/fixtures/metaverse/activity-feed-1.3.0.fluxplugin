rl), trailing: Symbol(name: \"check_circle\")),\r\n  default: ListItem(title: u.username, leading: Avatar(label: u.username, url: u.avatarUrl), trailing: switch u.chosen {true: Symbol(name: \"check_circle\", color: \"primary\"), default: Symbol(name: \"add\")}, onTap: event \"pick\" {name: u.username})\r\n}]);\r\n\nwidget LocalizedTitle = Label(text: data.pageTitle, style: \"titleLarge\", maxLines: 1);\n","main.js":"// 此文件由 tools/localize.mjs 生成，业务源码与翻译见 src/、locales/。\n((host)=>{\n const catalogs={\"zh\":{\"s5edf0d2dfa525fe8\":\"通知尚未开启。可再次点开关申请，并检查系统是否允许 FluxDO 发送通知。\",\"sbc63a7c1c9be3b27\":\"请先添加订阅用户\",\"s2e770b687629f3ec\":\"已更新 \",\"s393128d5d3e9a86c\":\"正在更新 \",\"s2a3b47ffe860958e\":\"已添加 {0} 位订阅\",\"sc635e79e9b58810a\":\"最多订阅 50 人，请减少选择\",\"se61422d7bac5e99f\":\"已订阅 {0}\",\"s9036f7a90822785f\":\"该用户已在名单中，或已达 50 人上限\",\"s6648820f4718cc24\":\"请输入有效的论坛用户名\",\"sfe62b636e3b77471\":\"{0}，首次更新未完成。{1}\",\"s5da6a920da32d60e\":\" 位订阅\",\"s2a9010137d7ba142\":\"已导入 \",\"sc55916f90438e6a5\":\"没有找到这个用户\",\"sa4a20e9ac255258a\":\"最多订阅 50 人，请减少名单\",\"s082aaa7aa9d2be98\":\"请输入用户名，每行一位，也可用空格或逗号分隔\",\"s98a2753a54b815ab\":\"更新未完成，将自动重试\",\"s523fb6184d48298d\":\"{0} 秒\",\"sb28945155ccd7976\":\" · 未读\",\"s5c55a67935af8f45\":\"全部\",\"s133f500d1624e24e\":\"添加所选（{0}）\",\"sb5046209970d3db3\":\"暂无动态\",\"see30635962bf9c82\":\"没有这类动态\",\"s74572450882f687f\":\"没有未读动态\",\"s146790885b1d568f\":\"还没有订阅\",\"sd6bc651b67117e14\":\"{0} 位订阅 · {1} 条未读\",\"s8cf8b8fb828a03de\":\"未读动态\",\"s8739378e59b2c938\":\"订阅用户\",\"s6170ff9554cef64c\":\"请先登录 FluxDO 论坛账号，再添加订阅。\",\"sa76199f40aa9c334\":\"{0} 条未读动态\",\"sdfa2ffad55077d69\":\"有新的订阅动态\",\"sa1359137557c53eb\":\"无标题话题\",\"s267e481ec1af6a70\":\"未允许{0}。再次点击此功能可重新申请。\",\"sf31a9f3f1073da6e\":\"请安装插件后使用系统任务和通知\",\"s495bc79da6bbc69f\":\"网络连接失败，请重试\",\"sb349e315c004ef8c\":\"当前账号无法读取这些动态\",\"sc231b1a2549a8a81\":\"请先登录论坛\",\"s2ff77baa08e96609\":\"论坛请求较多，请稍后再试\",\"sc0783c4f312aa20b\":\"页面已离开，更新已暂停\",\"s8bd2f5a49f5cfbb0\":\"另一轮更新正在进行，请稍后查看\",\"s45727a2cc1b1a3dd\":\"「{