in data.types: Padding(padding: [0.0,0.0,6.0,0.0], child: Choice(label: t.label, selected: t.selected, onSelected: event \"select\" {kind: t.id}))\n        ]))),\n        switch data.hasUnread {true: IconButton(icon: \"check_circle\", tooltip: data.i18n.s748ae6920776e7c8, onPressed: event \"read\" {}), default: SizedBoxShrink()}\n      ]), default: SizedBoxShrink()},\n      switch data.needsActivity {true: ListItem(title: data.i18n.sf959b11c48af2cac, subtitle: data.i18n.s02d786f1a036854d, trailing: Button(label: data.i18n.sa4d43e65c3f14473, variant: \"tonal\", onPressed: event \"refresh\" {})), default: SizedBoxShrink()},\n      Notice()\n    ]),\n    items: [...for r in data.items: ContentRow(title: r.title, summary: r.summary, meta: r.meta, leading: GestureDetector(child: Avatar(label: r.name, url: r.avatar), onTap: event \"profile\" {name: r.name}), detail: RelativeTime(value: r.time), onTap: event \"topic\" {topic: r.topic, post: r.post, owner: r.owner, id: r.id})]\n  )\n);\nwidget PeopleStrip = SingleChildScrollView(scrollDirection: \"horizontal\", primary: false, child: Row(children: [...for p in data.people: Padding(padding: [0.0,0.0,4.0,0.0], child: Choice(label: p.label, layout: \"stacked\", leading: Avatar(label: p.name, url: p.avatar, size: 34, count: p.count), selected: p.selected, onSelected: event \"select\" {who: p.name}))]));\nwidget FeedEmpty = switch data.hasUsers {\n  true: EmptyState(title: data.empty, icon: \"history\", action: switch data.filtered {true: Button(label: data.i18n.s657d9cbf45ec9e6a, variant: \"text\", onPressed: event \"reset\" {}), default: Button(label: data.i18n.sd50376b775b81ef6, variant: \"text\", onPressed: event \"refresh\" {})}),\n  default: EmptyState(title: data.i18n.s5891162dfd7b0df0, message: data.i18n.seeb00343a5a2c958, icon: \"group\", action: Wrap(alignment: \"center\", spacing: 8.0, children: [Button(label: data.i18n.s40e8c231c87f5ad8, icon: \"add\", onPressed: event \"new\" {}), Button(label: data.i18n.sfa669a1e79f7db60, variant: \"tonal\", onPressed: event \"import\" {})]))\n};\nwidget Notice = Column(crossAxisAlignment: \"stretch\", children: [\n  switch data.olderWindow {true: Button(label: data.i18n.s6c8879b735bc2f97, variant: \"text\", onPressed: event \"reset\" {}), default: SizedBoxShrink()},\n  switch data.historyWindowEnd {true: Button(label: data.i18n.sb42e32d04aae9a48, variant: \"tonal\", onPressed: event \"historyNext\" {}), default: SizedBoxShrink()},\n  switch data.progress {\"\": SizedBoxShrink(), default: Label(text: data.progress, style: \"bodySmall\", color: \"onSurfaceVariant\")},\n  switch data.error {\"\": SizedBoxShrink(), default: Label(text: data.error, color: \"error\")},\n  switch data.historyError {\"\": SizedBoxShrink(), default: ListItem(title: data.historyError, trailing: Button(label: data.i18n.sb8784c8dd5636ff2, variant: \"text\", onPressed: event \"more\" {}))},\n  switch data.scheduleError {\"\": SizedBoxShrink(), default: Label(text: data.scheduleError, color: \"onSurfaceVariant\")}\n]);\nwidget Settings = ListPage(header: Column(crossAxisAlignment: \"stretch\", children: [\n    Wrap(spacing: 8.0, children: [Button(label: data.i18n.s40e8c231c87f5ad8, icon: \"add\", onPressed: event \"new\" {}), Button(label: data.i18n.sfa669a1e79f7db60, variant: \"tonal\", onPressed: event \"import\" {}), Button(label: data.i18n.s105835b30cf363b4, variant: \"tonal\", onPressed: event \"bulk\" {})]),\n    Gap(size: 16), Notice(), Surface(child: Column(children: [\n      ListItem(title: data.i18n.s736cff237d7d9255, subtitle: data.i18n.s27e0cb22379330f2, trailing: Toggle(value: data.enabled, onChanged: event \"schedule\" {mode: \"enable\"})),\n      switch data.enabled {true: Wrap(spacing: 6.0, children: [...for p in data.pace: Choice(label: p.label, selected: p.selected, onSelected: event \"schedule\" {pace: p.n})]), default: SizedBoxShrink()},\n      ListItem(title: data.i18n.s398e38a1f557fe51, subtitle: data.i18n.s996d5a26af0fea4e, trailing: Toggle(value: data.background, onChanged: event \"schedule\" {mode: \"background\"})),\n      ListItem(title: data.i18n.s80733323a1111e63, trailing: Toggle(value: data.notify, onChanged: event \"notify\" {})),\n      switch data.notificationBlocked {true: Padding(padding: [16.0, 12.0, 16.0, 12.0], child: Column(crossAxisAlignment: \"stretch\", children: [Label(text: data.i18n.s8219de42a4b88abe, style: \"titleSmall\"), Gap(size: 4), Label(text: data.i18n.s89193ebd15971d26, color: \"onSurfaceVariant\"), Gap(size: 8), switch data.notificationSettings {true: Button(label: data.i18n.s68ea5dd4d7af20e6, variant: \"tonal\", onPressed: event \"notificationSettings\" {}), default: SizedBoxShrink()}])), default: SizedBoxShrink()},\n      switch data.notificationUnknown {true: Label(text: data.i18n.s01eda9df8e0d7635, style: \"bodySmall\", color: \"onSurfaceVariant\"), default: SizedBoxShrink()}\n    ])), Gap(size: 16), Label(text: data.i18n.s79aad303b15f3ed3, style: \"titleSmall\")]),\n    emptyTitle: data.i18n.s146790885b1d568f, items: [...for u in data.users: ListItem(title: u.name, leading: Avatar(label: u.name, url: u.avatar), onTap: event \"profile\" {name: u.name}, trailing: IconButton(icon: \"delete\", tooltip: data.i18n.s1b3040a24c036cea, onPressed: event \"remove\" {id: u.id}))]\n);\nwidget AddPerson = PageLayout(children: [TextInput(label: data.i18n.sde365d163cd8e3dd, hint: \"@username\", value: data.input, onChanged: event \"input\" {}, onSubmitted: event \"add\" {}), Gap(size: 12), Notice(), Button(label: data.i18n.sfd6bde53aaf4edea, icon: \"add\", loading: data.submitting, onPressed: event \"add\" {})]);\nwidget BulkImport = PageLayout(children: [Label(text: data.i18n.sbd62a91c027770fb, color: \"onSurfaceVariant\"), Gap(size: 16), TextInput(label: data.i18n.s19a6fac4e33156a5, value: data.bulk, maxLines: 8, onChanged: event \"bulkInput\" {}), Gap(size: 12), Notice()], footer: Button(label: data.i18n.s1d44dd136cbbe908, loading: data.submitting, onPressed: event \"bulkApply\" {}));\nwidget Following = ListPage(search: SearchInput(hint: data.i18n.s10dde5f6ba4e7531, value: data.query, onChanged: event \"query\" {}), header: Notice(), loading: data.candidatesLoading, error: data.candidatesError, onRetry: event \"candidates\" {retry: true}, empty: EmptyState(title: data.i18n.s66fe2bf52b5748b5, icon: \"group\", action: switch data.nextCandidates {true: Button(label: data.i18n.s7e7af41bb778403b, variant: \"text\", onPressed: event \"candidates\" {more: true}), default: SizedBoxShrink()}), onRefresh: event \"candidates\" {}, hasMore: data.nextCandidates, loadingMore: data.candidatesLoading, onLoadMore: event \"candidates\" {more: true}, actions: Button(label: data.pickLabel, enabled: data.canPick, loading: data.submitting, onPressed: event \"apply\" {}), items: [...for u in data.choices: switch u.added {\n  true: ListItem(title: u.username, subtitle: data.i18n.s5ac3c3737429b384, leading: Avatar(label: u.username, url: u.avatarUrl), trailing: Symbol(name: \"check_circle\")),\n  default: ListItem(title: u.username, leading: Avatar(label: u.username, url: u.avatarUrl), trailing: switch u.chosen {true: Symbol(name: \"check_circle\", color: \"primary\"), default: Symbol(name: \"add\")}, onTap: event \"pick\" {name: u.username})\n}]);\n\nwidget LocalizedTitle = Label(text: data.pageTitle, style: \"titleLarge\", maxLines: 1);\n","main.js":"// 此文件由 fluxdo localize 生成，业务源码与翻译见 src/、locales/。\n((host)=>{\n const catalogs={\"zh\":{\"s5edf0d2dfa525fe8\":\"通知尚未开启。可再次点开关申请，并检查系统是否允许 FluxDO 发送通知。\",\"sbc63a7c1c9be3b27\":\"请先添加订阅用户\",\"s2e770b687629f3ec\":\"已更新 \",\"s393128d5d3e9a86c\":\"正在更新 \",\"s2a3b47ffe860958e\":\"已添加 {0} 位订阅\",\"sc635e79e9b58810a\":\"最多订阅 50 人，请减少选择\",\"se61422d7bac5e99f\":\"已订阅 {0}\",\"s9036f7a90822785f\":\"该用户已在名单中，或已达 50 人上限\",\"s6648820f4718cc24\":\"请输入有效的论坛用户名\",\"sfe62b636e3b77471\":\"{0}，首次更新未完成。{1}\",\"s5da6a920da32d60e\":\" 位订阅\",\"s2a9010137d7ba142\":\"已导入 \",\"sc55916f90438e6a5\":\"没有找到这个用户\",\"sa4a20e9ac255258a\":\"最多订阅 50 人，请减少名单\