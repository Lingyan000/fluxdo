])};
widget BuyerFeedback = switch data.buyerError {"": SizedBoxShrink(), default: Padding(padding: [0.0, 12.0, 0.0, 12.0], child: Label(text: data.buyerError, color: "error"))};
widget BuyerLogin = switch data.needsSession {true: LoginButton(), default: SizedBoxShrink()};

widget Account = ListPage(loading: data.overviewLoading, onRefresh: event "overviewRefresh" {},
  header: Column(crossAxisAlignment: "stretch", children: [
    switch data.accountName {"": SizedBoxShrink(), default: Padding(padding: [0.0, 0.0, 0.0, 20.0], child: Row(children: [Avatar(label: data.accountName, url: data.accountAvatar, size: 48), Gap(size: 12), Expanded(child: Column(crossAxisAlignment: "start", children: [Label(text: data.accountName, style: "titleLarge", bold: true), Label(text: data.accountMeta, style: "bodySmall", color: "onSurfaceVariant")]))]))},
    Statistics(items: data.stats, loading: data.overviewInitialLoading), Gap(size: 12), Label(text: data.overviewError, style: "bodySmall", color: "onSurfaceVariant"), LoginButton()]),
  items: [
    ListItem(title: "我的订单", subtitle: "付款、交付与售后", leading: Symbol(name: "history"), trailing: Symbol(name: "chevron_right"), onTap: event "orders" {}),
    switch data.refundHint {"": SizedBoxShrink(), default: ListItem(title: data.refundHint, leading: Symbol(name: "info"), trailing: Symbol(name: "chevron_right"), onTap: event "orders" {status: "refund_pending,refunded,refund_failed"})},
    ListItem(title: "我的收藏", leading: Symbol(name: "favorite"), trailing: Symbol(name: "chevron_right"), onTap: event "favorites" {}),
    ListItem(title: "我的优惠券", subtitle: data.couponHint, leading: Symbol(name: "gift"), trailing: Symbol(name: "chevron_right"), onTap: event "coupons" {}),
    ListItem(title: "士多消息", leading: Symbol(name: "mail"), trailing: Symbol(name: "chevron_right"), onTap: event "messages" {}),
    switch data.authorized {true: ListItem(title: "消费记录", subtitle: data.spendingSummary, leading: Symbol(name: "payments"), trailing: Label(text: switch data.spendingOpen {true: "收起", default: "展开"}, style: "labelMedium", color: "primary"), onTap: event "spending" {}), default: SizedBoxShrink()},
    switch data.spendingOpen {true: Padding(padding: [16.0], child: Column(crossAxisAlignment: "stretch", children: [
      switch data.spendingLoading {true: TextSkeleton(), default: SizedBoxShrink()},
      ...for row in data.spendingRows: DetailRow(label: row.label, value: row.value),
      switch data.spendingEmpty {true: Label(text: "还没有已成交的购买记录", style: "bodySmall", color: "onSurfaceVariant"), default: SizedBoxShrink()},
      switch data.spendingError {"": SizedBoxShrink(), default: Column(children: [Label(text: data.spendingError, color: "error"), Button(label: "重试", variant: "text", onPressed: event "spendingRetry" {})])},
    ])), default: SizedBoxShrink()},
    switch data.hasRecentOrders {true: Padding(padding: [16.0, 16.0, 16.0, 4.0], child: SectionTitle(title: "最近订单")), default: SizedBoxShrink()},
    ...for recent in data.recentOrders: ListItem(title: recent.title, subtitle: recent.subtitle, leading: Symbol(name: "history"), trailing: Symbol(name: "chevron_right"), onTap: event "order" {no: recent.no}),
  ], actions: switch data.authorized {true: Button(label: "退出士多登录", variant: "text", onPressed: event "signOut" {}), default: SizedBoxShrink()},
);

widget Favorites = GridPage(loadingPlaceholder: GridSkeleton(), layout: "equalHeight", minTileWidth: 156, loading: data.loading, loadingMore: data.loadingMore,
