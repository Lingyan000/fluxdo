    <group
        android:translateX="90"
        android:translateY="90"
        android:scaleX="0.10546875"
        android:scaleY="0.10546875">

        <path
            android:fillColor="#F0F0F0"
            android:pathData="M 512 64 A 448 448 0 1 0 512 960 A 448 448 0 1 0 512 64 Z" />

        <path
            android:fillColor="#1C1C1E"
