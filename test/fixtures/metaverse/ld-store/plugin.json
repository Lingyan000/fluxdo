{
  "schema": 12,
  "apiVersion": 2,
  "id": "community.fluxdo.ldstore",
  "name": "LD士多",
  "version": "2.5.1",
  "author": "FluxDO 社区",
  "description": "浏览与搜索商品，原生登录、确认订单、使用 LDC 支付并查看交付内容。",
  "homepage": "https://ldcstore.com/",
  "webLogin": "https://ldcstore.com/login",
  "icon": "storefront",
  "ui": "ui.rfwtxt",
  "script": "main.js",
  "permissions": {
    "network": [
      "api2.ldspro.qzz.io",
      "api1.ldspro.qzz.io",
      "api.ldspro.qzz.io",
      "ldcstore.com"
    ],
    "publicImages": true,
    "identity": true,
    "connect": [
      "https://api.ldspro.qzz.io/api/auth/callback",
      "https://api1.ldspro.qzz.io/api/auth/callback",
      "https://api2.ldspro.qzz.io/api/auth/callback"
    ],
    "credentials": {
      "account": {
        "requests": [
          {
            "origin": "https://api2.ldspro.qzz.io",
            "pathPrefix": "/api/shop",
            "methods": [
              "GET",
              "POST"
            ]
          },
          {
            "origin": "https://api2.ldspro.qzz.io",
            "pathPrefix": "/api/shop/products",
            "methods": [
              "DELETE"
            ]
          }
        ]
      }
    },
    "payments": [
      "linuxDoCredit"
    ]
  },
  "card": {
    "widget": "Card",
    "page": "market"
  },
  "pages": [
    {
      "id": "orders",
      "widget": "BuyerOrders",
      "scroll": false,
      "title": "我的订单"
    },
    {
      "id": "order",
      "widget": "BuyerOrder",
      "scroll": false,
      "title": "订单详情",
      "presentation": "modal",
      "appBar": {
        "actions": "OrderActions"
      }
    },
    {
      "id": "market",
      "widget": "Market",
      "scroll": false,
      "title": "LD士多",
      "appBar": {
        "actions": "MarketActions"
      }
    },
    {
      "id": "review",
      "widget": "Review",
      "scroll": false,
      "title": "确认订单"
    },
    {
      "id": "product",
      "widget": "Product",
      "scroll": false,
      "title": "商品详情",
      "presentation": "modal",
      "appBar": {
        "actions": "ProductActions"
      }
    },
    {
      "id": "favorites",
      "widget": "Favorites",
      "scroll": false,
      "title": "我的收藏"
    },
    {
      "id": "coupons",
      "widget": "Coupons",
      "scroll": false,
      "title": "我的优惠券"
    },
    {
      "id": "coupon",
      "widget": "Coupon",
      "scroll": false,
      "title": "领取优惠券",
      "presentation": "modal"
    },
    {
      "id": "refund",
      "widget": "Refund",
      "scroll": false,
      "title": "退款与售后",
      "presentation": "modal"
    },
    {
      "id": "comment",
      "widget": "CommentForm",
      "scroll": false,
      "title": "发表评论",
      "presentation": "modal"
    },
    {
      "id": "merchant",
      "widget": "Merchant",
      "scroll": false,
      "title": "店铺商品"
    },
    {
      "id": "filters",
      "widget": "Filters",
      "title": "筛选商品",
      "scroll": false,
      "presentation": "modal"
    },
    {
      "id": "account",
      "widget": "Account",
      "title": "我的士多",
      "scroll": false
    },
    {
      "id": "messages",
      "widget": "Messages",
      "title": "士多消息",
      "scroll": false,
      "appBar": {
        "actions": "MessageActions"
      }
    }
  ],
  "links": [
    {
      "host": "ldcstore.com",
      "path": "/product/:id",
      "page": "product"
    },
    {
      "host": "ldcstore.com",
      "path": "/coupon/:token",
      "page": "coupon"
    }
  ],
  "requiredFeatures": [
    "confirmationDialog",
    "virtualGrid",
    "nativeExecutionLimits",
    "cardNavigation",
    "contentPresentation",
    "runtimePermissions",
    "modalDismiss",
    "eventStreams",
    "pageChrome",
    "loadingPlaceholders",
    "navigationReplacement",
    "credentialClaims",
    "iconButtonContent"
  ]
}
