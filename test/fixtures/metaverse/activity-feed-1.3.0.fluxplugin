{"manifest":{"schema":12,"apiVersion":2,"id":"community.fluxdo.activity","version":"1.3.0","name":"动态订阅","author":"FluxDO 社区","description":"按名单聚合论坛动态，保留最近记录并提醒未读。","icon":"history","ui":"ui.rfwtxt","script":"main.js","requiredFeatures":["forumRead","navigationEntries","navigationBadge","scheduledTasks","localNotifications","atomicStorage","runtimePermissions","adaptiveCollections","modalDismiss","cardNavigation","contentPresentation","notificationStatus","hostEnvironment","pageChrome"],"permissions":{"network":[],"forum":["profiles","following","activity"],"identity":true,"background":true,"notifications":true},"tasks":[{"id":"refresh","title":"更新订阅动态"}],"card":{"widget":"Card","page":"feed"},"pages":[{"id":"feed","title":"动态订阅","widget":"Feed","scroll":false,"navigation":{"label":"订阅","icon":"history"},"appBar":{"title":"LocalizedTitle"}},{"id":"settings","title":"订阅管理","widget":"Settings","scroll":false,"appBar":{"title":"LocalizedTitle"}},{"id":"add","title":"添加订阅","widget":"AddPerson","presentation":"modal","scroll":false,"appBar":{"title":"LocalizedTitle"}},{"id":"following","title":"从关注中选择","widget":"Following","presentation":"modal","scroll":false,"appBar":{"title":"LocalizedTitle"}},{"id":"bulk","title":"批量导入订阅","widget":"BulkImport","presentation":"modal","scroll":false,"appBar":{"title":"LocalizedTitle"}}]},"files":{"ui.rfwtxt":"import fluxdo;\r\n\r\nwidget Card = Statistics(items: data.stats);\r\nwidget Feed = AdaptivePane(\r\n  compactHeader: switch data.hasUsers {true: Padding(padding: [12.0, 4.0, 12.0, 0.0], child: PeopleStrip()), default: SizedBoxShrink()},\r\n  sidebar: ListPage(header: Label(text: data.i18n.s79aad303b15f3ed3, style: \"titleMedium\"), items: [\r\n    ...for p in data.people: ListItem(title: p.label, leading: Avatar(label: p.name, url: p.avatar, count: p.count), trailing: switch p.selected {true: Symbol(name: \"check\", color: \"primary\"), default: SizedBoxShrink()}, onTap: event \"select\" {who: p.name})\r\n  ]),\r\n  body: ListPage(empty: FeedEmpty(), loading: data.manual, hasMore: data.more, loadingMore: data.historyLoading, onLoadMore: event \"more\" {}, onRefresh: event \"refresh\" {},\r\n    header: Column(crossAxisAlignment: \"stretch\", children: [\r\n      Row(children: [Expanded(child: Label(text: data.title, style: \"labelLarge\", color: \"onSurfaceVariant\")), IconButton(icon: \"group\", tooltip: data.i18n.sfa669a1e79f7db60, onPressed: event \"import\" {}), IconButton(icon: \"add\", tooltip: data.i18n.sfa9d1a2012dc7f61, onPressed: event \"new\" {}), IconButton(icon: \"settings\", tooltip: data.i18n.s3725212d2092c70a, onPressed: event \"manage\" {})]),\r\n      switch data.hasUsers {true: Row(children: [\r\n        Expanded(child: SingleChildScrollView(scrollDirection: \"horizontal\", primary: false, child: Row(children: [\r\n          Choice(label: data.i18n.s4d0680f9efaef147, selected: data.unreadOnly, onSelected: event \"unread\" {}), Gap(size: 8),\r\n          ...for t in data.types: Padding(padding: [0.0,0.0,6.0,0.0], child: Choice(label: t.label, selected: t.selected, onSelected: event \"select\" {kind: t.id}))\r\n        ]))),\r\n        switch data.hasUnread {true: IconButton(icon: \"check_circle\", tooltip: data.i18n.s748ae6920776e7c8, onPressed: event \"read\" {}), default: SizedBoxShrink()}\r\n      ]), default: SizedBoxShrink()},\r\n      switch data.needsActivity {true: ListItem(title: data.i18n.sf959b11c48af2cac, subtitle: data.i18n.s02d786f1a036854d, trailing: Button(label: data.i18n.sa4d43e65c3f14473, variant: \"tonal\", onPressed: event \"refresh\" {})), default: SizedBoxShrink()},\r\n      Notice()\r\n    ]),\r\n    items: [...for r in data.items: ContentRow(title: r.title, summary: r.summary, meta: r.meta, leading: GestureDetector(child: Avatar(label: r.name, url: r.avatar), onTap: event \"profile\" {name: r.name}), detail: RelativeTime(value: r.time), onTap: event \"topic\" {topic: r.topic, post: r.post, owner: r.owner, id: r.id})]\r\n  )\r\n);\r\nwidget PeopleSt