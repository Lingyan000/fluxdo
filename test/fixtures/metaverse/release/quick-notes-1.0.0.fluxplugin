{"manifest":{"schema":9,"apiVersion":2,"id":"community.fluxdo.quicknotes","name":"随手记","version":"1.0.0","author":"FluxDO 社区","description":"保存在设备上的轻量备忘，可在元宇宙中直接编辑。","icon":"edit","ui":"ui.rfwtxt","script":"main.js","permissions":{"network":[]},"card":{"widget":"Card"},"pages":[]},"files":{"ui.rfwtxt":"import fluxdo;\nwidget Card = TextInput(label: \"随手记\", hint: \"记下待办或灵感\", value: data.note, maxLines: 4, onChanged: event \"save\" {});\n","main.js":"// 使用宿主存储，内容保存在本机。\nfluxdo.on('card.load', async ctx => {\n  ctx.setData('note', await ctx.api.storage.get('note') || '');\n});\nfluxdo.on('save', async (ctx, args) => {\n  await ctx.api.storage.set('note', args.value);\n});\n"},"publisher":{"algorithm":"RSA-SHA256","key":{"kty":"RSA","n":"plWHt2SGYJ_QFf4dzbvcMrNIUJE2TeTb0_iq3CxrEnfBvtTI9ap60vuuJBIHCrAe2XoRUwSc2tcrIIM9eJE3Mxq9QGjT6E_1J99PiHz89jTlNo9rVEgNfq-7yJ7hnL9HF0qbw9oa3g864pQAHzYxfVkkyogoFvAmQTmPDiW1HqRO1NtBAMSDu8JoHJuvnfXL7wy8JzoFaB2eEPY75DxBXwi5kk3ugQq0TkCaE5fN1ZElpZWitVUvbZVx9_GRjL9Oc87suL-PmrGsqXaohReaZTyMKl3iKNwX0tpEuOt3tyhnZ8l5F8xivlebk-VHZOGsrJWqMb33aOPokPjfIIBQBIIoHFvLD0xHoMzbK70JzJkpnxOd2QQXXZDXaOL5J9Io6rgD7AaTqGEqFX7fckQP2uBEafHvZe1nayCHIKcBqMRA16RBeW9rdnLcyqVsZ7yaYVY6Hs0PmJ8I-daogZJhwKqgjUpJZpXMKszDYPt-OazIv8931AUurhC7lsMSLj89","e":"AQAB"},"signature":"bXIxbzHskbGt9-Vwv1s5xamezQfk3ywmhfSOSF_h2ePdUQ6mHV7V2jOPoVXsrSBsZocN3Vs-HkTwT-WF8Yal5GpqFiCv6GTUwYvJOxdXXQYuutNyunedxk1BZ3ZTdFcL4SmzGHYnCVyf-ErY7MBuX8TzcWYoAJPjj4YqiOeiPkOGpt2UkdjHb1ZOHFqtxIPUphSrI8571cXLXz94Ngh5WXHExKfF4PgXzR66qxiJDMMLAvtgvjiJCIEjV9kLHQDEO9q1sTFqinqAmqLuCm4SDuIqR1gv4CdeByaiW-2y0wSZ-1KwioJNzhIrETpwwrFSfrF65AEbD7X0mhwlZjSotNJhXpe2cG_2HM91NZmK2WaMM5Eirzv9v70fmhIZblNw-Rr-c5xonl8TSaHc0Eq6j1B5RRq_Kqx7CBxivulQPG-N5pZ7R7uULoNL9CS5F216JJ6J3vBV9H1YNAGYwBaNqj-QVhkXrAH99k3cuQ_Ud_2YRF_xBdAbwv_jFCfE2yu9"}}