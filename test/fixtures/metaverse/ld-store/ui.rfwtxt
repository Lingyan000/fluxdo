import fluxdo;

widget TextSkeleton = Skeleton(child: Column(crossAxisAlignment: "stretch", children: [
  SkeletonBox(width: 140, height: 20), Gap(size: 12), SkeletonBox(height: 16),
  Gap(size: 8), FractionallySizedBox(widthFactor: 0.65, alignment: "centerLeft", child: SkeletonBox(height: 16)),
]));
widget SummarySkeleton = Skeleton(child: Surface(child: Column(crossAxisAlignment: "stretch", children: [
  Row(children: [SkeletonBox(width: 72, height: 72, radius: 12), Gap(size: 12), Expanded(child: Column(crossAxisAlignment: "stretch", children: [SkeletonBox(height: 20), Gap(size: 12), SkeletonBox(width: 96, height: 16)]))]),
  Gap(size: 24), SkeletonBox(height: 18), Gap(size: 20), SkeletonBox(height: 18), Gap(size: 20), SkeletonBox(height: 18),
])));
widget ProductSkeleton = Column(crossAxisAlignment: "stretch", children: [
  Skeleton(child: AspectRatio(aspectRatio: 1.35, child: SkeletonBox(height: 240, radius: 16))),
  Gap(size: 20), TextSkeleton(), Gap(size: 24), SummarySkeleton(),
]);
widget ReviewSkeleton = Column(crossAxisAlignment: "stretch", children: [SummarySkeleton(), Gap(size: 24), TextSkeleton()]);
widget RowsSkeleton = Column(crossAxisAlignment: "stretch", children: [
  Surface(child: TextSkeleton()), Gap(size: 12), Surface(child: TextSkeleton()), Gap(size: 12), Surface(child: TextSkeleton()),
]);
widget TileSkeleton = Skeleton(child: Surface(padding: [0.0], child: Column(crossAxisAlignment: "stretch", children: [
  AspectRatio(aspectRatio: 1.4, child: SkeletonBox(height: 128, radius: 0)),
  Padding(padding: [10.0], child: Column(crossAxisAlignment: "stretch", children: [SkeletonBox(height: 18), Gap(size: 10), SkeletonBox(width: 80, height: 22), Gap(size: 10), SkeletonBox(height: 14)])),
])));
widget GridSkeleton = TileGrid(layout: "equalHeight", minTileWidth: 156, children: [TileSkeleton(), TileSkeleton(), TileSkeleton(), TileSkeleton()]);


widget Card = Column(mainAxisSize: "min", crossAxisAlignment: "stretch", children: [
  Statistics(items: data.stats, loading: data.overviewInitialLoading),
  switch data.overviewError {"": SizedBoxShrink(), default: Label(text: data.overviewError, style: "bodySmall", color: "onSurfaceVariant")},
]);

widget MarketActions = Row(mainAxisSize: "min", children: [
  IconButton(icon: "settings", tooltip: "筛选商品", onPressed: event "filters" {}),
  IconButton(icon: "person", tooltip: "我的士多", onPressed: event "account" {},
    child: switch data.authorized {true: Avatar(label: data.accountName, url: data.accountAvatar, size: 28), default: Symbol(name: "person")}),
]);
widget ProductActions = Row(mainAxisSize: "min", children: [
  IconButton(icon: "favorite", selected: data.favorited, tooltip: data.favoriteLabel,
    enabled: data.ready, loading: data.buyerBusy, onPressed: event "favorite" {}),
  IconButton(icon: "open_in_new", tooltip: "在网页中查看商品", onPressed: event "webProduct" {}),
]);
widget OrderActions = Row(mainAxisSize: "min", children: [
  IconButton(icon: "history", tooltip: "退款与售后", enabled: data.ready, onPressed: event "refund" {}),
  IconButton(icon: "refresh", tooltip: "刷新订单", loading: data.loading, onPressed: event "ordersRefresh" {}),
]);
widget MessageActions = Row(mainAxisSize: "min", children: [
  IconButton(icon: "done_all", tooltip: "全部已读", enabled: data.unread, loading: data.buyerBusy, onPressed: event "messagesReadAll" {}),
  IconButton(icon: "open_in_new", tooltip: "网站消息中心", onPressed: event "webMessages" {}),
]);

widget Market = GridPage(loadingPlaceholder: GridSkeleton(), layout: "equalHeight", minTileWidth: 156,
  hasMore: data.more, loadingMore: data.loadingMore, onLoadMore: event "more" {},
  loading: data.loading, error: data.message, emptyTitle: "没有符合条件的商品",
  onRefresh: event "refresh" {}, onRetry: event "marketRetry" {},
  toolbar: Column(crossAxisAlignment: "stretch", children: [
    SearchInput(value: data.search, hint: "搜索商品", onChanged: event "input" {field: "search"}, onSubmitted: event "apply" {}),
    Gap(size: 8),
    SingleChildScrollView(scrollDirection: "horizontal", primary: false, child: Row(children: [
      ...for c in data.categories: Padding(padding: [0.0, 0.0, 8.0, 0.0], child: Choice(label: c.name, selected: c.selected, onSelected: event "select" {cat: c.id, label: c.name})),
    ])),
  ]),
  header: Wrap(spacing: 12.0, runSpacing: 4.0, children: [
    Label(text: data.total, style: "titleSmall"), Label(text: data.selection, style: "bodySmall", color: "onSurfaceVariant"),
    switch data.categoryMessage {"": SizedBoxShrink(), default: Label(text: data.categoryMessage, style: "bodySmall", color: "error")},
  ]),
  actions: switch data.webFallback {true: Button(label: "在网页中浏览士多", variant: "text", onPressed: event "webMarket" {}), default: SizedBoxShrink()},
  items: [...for item in data.rows: ProductTile(item: item)],
);

widget ProductTile = switch args.item.hiddenItem {true: Surface(padding: [0.0], child: Column(crossAxisAlignment: "stretch", children: [TileContent(item: args.item), Button(label: "恢复展示", variant: "text", onPressed: event "restoreProduct" {id: args.item.id})])), default: Surface(padding: [0.0], onTap: event "product" {id: args.item.id}, child: TileContent(item: args.item))};
widget TileContent = Column(crossAxisAlignment: "stretch", children: [
  AspectRatio(aspectRatio: 1.4, child: switch args.item.image {"": Center(child: Symbol(name: args.item.typeIcon, size: 32, color: "onSurfaceVariant")), default: Image(url: args.item.image, fit: "cover")}),
  Padding(padding: [10.0], child: Column(crossAxisAlignment: "stretch", children: [
    switch args.item.listingNote {"": SizedBoxShrink(), default: Label(text: args.item.listingNote, style: "labelSmall", color: "primary")},
    Label(text: args.item.title, style: "titleSmall", maxLines: 2), Gap(size: 6),
    Amount(value: args.item.value, unit: "LDC", style: "titleMedium"),
    switch args.item.discount {"": SizedBoxShrink(), default: Padding(padding: [0.0, 2.0, 0.0, 0.0], child: Wrap(spacing: 8.0, runSpacing: 2.0, children: [
      Label(text: args.item.discount, style: "labelSmall", color: "primary"),
      Label(text: args.item.originalLabel, style: "labelSmall", color: "onSurfaceVariant"),
    ]))},
    Gap(size: 6), Wrap(spacing: 8.0, runSpacing: 2.0, children: [
      Label(text: args.item.stock, style: "labelSmall", color: "onSurfaceVariant"),
      Label(text: args.item.sold, style: "labelSmall", color: "onSurfaceVariant"),
    ]),
    switch args.item.availability {"": SizedBoxShrink(), default: Label(text: args.item.availability, style: "labelSmall", color: "primary")},
    Gap(size: 4), Row(children: [
      Symbol(name: args.item.typeIcon, size: 14.0, color: "onSurfaceVariant"), Gap(size: 4),
      Expanded(child: Label(text: args.item.typeLabel, style: "labelSmall", color: "onSurfaceVariant", maxLines: 1)),
      switch args.item.sellerName {"": SizedBoxShrink(), default: Flexible(child: Row(mainAxisSize: "min", children: [
        switch args.item.sellerAvatar {"": SizedBoxShrink(), default: Padding(padding: [0.0, 0.0, 4.0, 0.0], child: Avatar(label: args.item.sellerName, url: args.item.sellerAvatar, size: 18))},
        Flexible(child: Label(text: args.item.sellerName, style: "labelSmall", color: "onSurfaceVariant", maxLines: 1, align: "end")),
      ]))},
    ]),
    switch args.item.preferenceTime {"": SizedBoxShrink(), default: Wrap(spacing: 4.0, children: [Label(text: switch args.item.hiddenItem {true: "隐藏于", default: "收藏于"}, style: "labelSmall", color: "onSurfaceVariant"), RelativeTime(value: args.item.preferenceTime)])},
  ])),
]);

widget Filters = PageLayout(loading: false, footer: Row(children: [
  Button(label: "重置", variant: "text", onPressed: event "resetFilters" {}), Gap(size: 12),
  Expanded(child: Button(label: "查看结果", onPressed: event "applyFilters" {})),
]), children: [
  Label(text: "排序", style: "titleSmall"), Gap(size: 12),
  Wrap(spacing: 8.0, runSpacing: 8.0, children: [...for o in data.sorts: Choice(label: o.label, selected: o.selected, onSelected: event "select" {sort: o.sort, direction: o.direction, label: o.label})]),
  Gap(size: 24), Label(text: "价格范围 · LDC", style: "titleSmall"), Gap(size: 12),
  Row(children: [Expanded(child: TextInput(value: data.min, label: "最低价", onChanged: event "input" {field: "min"})), Gap(size: 16), Expanded(child: TextInput(value: data.max, label: "最高价", onChanged: event "input" {field: "max"}))]),
  Gap(size: 24), ListItem(title: "仅显示有库存的商品", trailing: Toggle(value: data.stock, onChanged: event "stock" {})),
  Gap(size: 16), Label(text: data.filterError, color: "error"),
]);

widget Product = PageLayout(loading: data.loading, onRefresh: event "retry" {},
  hasMore: data.commentsMore, loadingMore: data.commentsLoading, loadMoreError: data.commentsError, onLoadMore: event "commentsMore" {},
  footer: switch data.ready {true: Column(mainAxisSize: "min", crossAxisAlignment: "stretch", children: [
    ExternalFeedback(),
    Row(children: [Expanded(child: Amount(value: data.value, unit: "LDC")), Gap(size: 12),
      Expanded(flex: 2, child: switch data.linkProduct {
        true: Button(fullWidth: true, label: data.buyLabel, icon: "open_in_new", enabled: data.buy, loading: data.externalBusy, onPressed: event "buy" {}),
        default: Button(fullWidth: true, label: data.buyLabel, enabled: data.buy, onPressed: event "review" {}),
      }),
    ]),
  ]), default: SizedBoxShrink()},
  children: [
    switch data.initialLoading {true: ProductSkeleton(), default: SizedBoxShrink()},
    switch data.ready {true: Column(crossAxisAlignment: "stretch", children: [
      switch data.image {"": SizedBoxShrink(), default: Surface(padding: [0.0], child: AspectRatio(aspectRatio: 1.35, child: Image(url: data.image, fit: "contain", preview: true)))},
      Gap(size: 20), Amount(value: data.value, unit: "LDC", original: data.original, style: "headlineMedium"),
      Gap(size: 12), Label(text: data.title, style: "titleLarge", bold: true), Gap(size: 12),
      Wrap(spacing: 8.0, runSpacing: 8.0, children: [Chip(label: data.typeLabel),
        switch data.category {"": SizedBoxShrink(), default: Chip(label: data.category)},
        switch data.discount {"": SizedBoxShrink(), default: Chip(label: data.discount)},
      ]),
      Gap(size: 20), Surface(child: Statistics(items: data.metrics)),
      Gap(size: 12), Surface(padding: [0.0], child: ListItem(title: data.sellerName, subtitle: "查看店铺商品",
        leading: Avatar(label: data.sellerName, url: data.sellerAvatar, size: 40), trailing: switch data.sellerProfileAvailable {true: IconButton(icon: "person", tooltip: "卖家主页", onPressed: event "sellerProfile" {}), default: Symbol(name: "chevron_right")}, onTap: event "seller" {})),
      Gap(size: 12), Label(text: data.listedAt, style: "bodySmall", color: "onSurfaceVariant"), BuyerFeedback(), LoginButton(),
      ...for rule in data.rules: Padding(padding: [0.0, 4.0, 0.0, 4.0], child: Row(crossAxisAlignment: "start", children: [Symbol(name: "info", size: 18.0, color: "onSurfaceVariant"), Gap(size: 8), Expanded(child: Label(text: rule, color: "onSurfaceVariant"))])),
      Gap(size: 24), SectionTitle(title: "商品说明"), Gap(size: 12), Markdown(text: data.description, onLink: event "contentLink" {}),
      Gap(size: 28), Row(children: [Expanded(child: SectionTitle(title: "商品评论")),
        switch data.canComment {true: Button(label: "写评论", icon: "edit", variant: "text", onPressed: event "comment" {}), default: SizedBoxShrink()},
      ]), Gap(size: 8),
      switch data.commentStatsReady {true: Statistics(items: data.commentStats), default: SizedBoxShrink()},
      ...for comment in data.comments: Padding(padding: [0.0, 8.0, 0.0, 12.0], child: Column(crossAxisAlignment: "stretch", children: [
        CommentBody(item: comment),
        switch comment.repliesOpen {true: Padding(padding: [20.0, 8.0, 0.0, 0.0], child: Column(crossAxisAlignment: "stretch", children: [
          ...for reply in comment.replies: Padding(padding: [0.0, 0.0, 0.0, 12.0], child: CommentBody(item: reply)),
          switch comment.repliesEmpty {true: Label(text: "暂无可见回复", style: "bodySmall", color: "onSurfaceVariant"), default: SizedBoxShrink()},
          switch comment.repliesError {"": switch comment.repliesMore {true: Button(label: "更多回复", variant: "text", loading: comment.repliesLoading, onPressed: event "commentReplies" {id: comment.id, more: true}), default: switch comment.repliesLoading {true: TextSkeleton(), default: SizedBoxShrink()}}, default: Column(children: [Label(text: comment.repliesError, color: "error"), Button(label: "重试", variant: "text", onPressed: event "commentReplies" {id: comment.id, more: comment.repliesMore})])},
        ])), default: switch comment.replyLabel {"": SizedBoxShrink(), default: Button(label: comment.replyLabel, variant: "text", onPressed: event "commentReplies" {id: comment.id})}},
      ])),
      Label(text: data.commentsMessage, color: "onSurfaceVariant"),
      switch data.commentsLoading {true: Spinner(), default: SizedBoxShrink()},
      switch data.commentsError {"": SizedBoxShrink(), default: Column(children: [Label(text: data.commentsError, color: "error"), Button(label: "重新加载评论", variant: "text", onPressed: event "commentsRetry" {})])},
      switch data.commentsMore {true: Button(label: "更多评论", variant: "text", onPressed: event "commentsMore" {}), default: SizedBoxShrink()},
    ]), default: SizedBoxShrink()},
    switch data.error {"": SizedBoxShrink(), default: EmptyState(icon: "error", title: data.error, action: ActionBar(actions: [Button(label: "重试", onPressed: event "retry" {}), Button(label: "在网页中查看商品", variant: "text", onPressed: event "webProduct" {})]))},
  ],
);

widget CommentBody = Column(crossAxisAlignment: "stretch", children: [
  Row(children: [Avatar(label: args.item.author, url: args.item.avatar, size: 32), Gap(size: 10), Expanded(child: Column(crossAxisAlignment: "start", children: [Label(text: args.item.author, style: "titleSmall"), switch args.item.handle {"": SizedBoxShrink(), default: Label(text: args.item.handle, style: "labelSmall", color: "onSurfaceVariant")} ])), Label(text: args.item.rating, style: "labelSmall", color: "primary")]),
  Gap(size: 8), SelectableLabel(text: args.item.content), Gap(size: 6), Wrap(spacing: 8.0, runSpacing: 4.0, children: [
    switch args.item.badge {"": SizedBoxShrink(), default: Label(text: args.item.badge, style: "labelSmall", color: "primary")},
    switch args.item.moderation {"": SizedBoxShrink(), default: Label(text: args.item.moderation, style: "labelSmall", color: "onSurfaceVariant")},
    RelativeTime(value: args.item.time),
  ]),
]);
widget SectionTitle = Label(text: args.title, style: "titleMedium", bold: true);
widget ProductSummary = Row(crossAxisAlignment: "start", children: [
  switch args.image {"": switch args.loading {true: Padding(padding: [0.0, 0.0, 12.0, 0.0], child: Skeleton(child: SkeletonBox(width: 72, height: 72, radius: 12))), default: SizedBoxShrink()}, default: Padding(padding: [0.0, 0.0, 12.0, 0.0], child: Image(url: args.image, width: 72, height: 72, radius: 12))},
  Expanded(child: Column(crossAxisAlignment: "start", children: [Label(text: args.title, style: "titleSmall", maxLines: 3), Gap(size: 6), Label(text: args.subtitle, style: "bodySmall", color: "onSurfaceVariant")]))
]);
widget Review = PageLayout(loading: data.loading, onRefresh: event "retry" {}, footer: Column(mainAxisSize: "min", crossAxisAlignment: "stretch", children: [ExternalFeedback(), ReviewAction()]), children: [
  switch data.initialLoading {true: ReviewSkeleton(), default: SizedBoxShrink()},
  switch data.ready {true: Column(crossAxisAlignment: "stretch", children: [
    Surface(child: Column(crossAxisAlignment: "stretch", children: [
      ProductSummary(image: data.image, title: data.title, subtitle: data.seller), Gap(size: 20),
      DetailRow(label: "单价", value: data.price), Gap(size: 16),
      Row(children: [Expanded(child: Label(text: "数量")), QuantityInput(value: data.quantityValue, max: data.quantityMax, enabled: data.buy, onChanged: event "quantity" {})]),
      Gap(size: 16), DetailRow(label: "商品小计", value: data.estimate),
    ])),
    Gap(size: 12), Label(text: data.conditions, style: "bodySmall", color: "onSurfaceVariant"),
    Gap(size: 24), SectionTitle(title: "选择优惠券"), Gap(size: 12),
    switch data.quoteInitialLoading {true: Skeleton(child: Surface(child: Column(crossAxisAlignment: "stretch", children: [SkeletonBox(height: 20), Gap(size: 24), SkeletonBox(height: 20)]))), default: SizedBoxShrink()},
    switch data.quoteReady {true: Surface(padding: [0.0], child: Column(crossAxisAlignment: "stretch", children: [
      ...for c in data.couponRows: ListItem(title: c.label, subtitle: c.subtitle, trailing: switch c.selected {true: Symbol(name: "check_circle", color: "primary"), default: Symbol(name: "gift", color: "onSurfaceVariant")}, onTap: event "quoteCoupon" {id: c.id}),
      ListItem(title: "不使用优惠券", trailing: switch data.noCoupon {true: Symbol(name: "check_circle", color: "primary"), default: SizedBoxShrink()}, onTap: event "quoteCoupon" {id: ""}),
      ...for c in data.unavailableCoupons: ListItem(title: c.label, subtitle: c.reason, leading: Symbol(name: "info", color: "onSurfaceVariant")),
    ])), default: SizedBoxShrink()},
    switch data.canQuote {true: Button(label: "刷新报价", enabled: switch data.quoting {true: false, default: true}, variant: "text", onPressed: event "quote" {}), default: SizedBoxShrink()},
    Label(text: data.quoteNote, color: "error"), Gap(size: 16), Row(children: [Expanded(child: Label(text: "应付积分", color: "onSurfaceVariant")), switch data.quoteInitialLoading {true: Skeleton(child: SkeletonBox(width: 104, height: 24)), default: Label(text: data.payable, style: "titleMedium")}]),
  ]), default: SizedBoxShrink()},
  switch data.nativeOrder {true: Column(crossAxisAlignment: "stretch", children: [
    switch data.orderState {
      "pending": SubmissionRecovery(),
      "missing": Column(children: [SubmissionRecovery(), Button(label: "用原提交号重试", variant: "outlined", loading: data.orderBusy, onPressed: event "retrySubmission" {})]),
      "created": Surface(child: Column(crossAxisAlignment: "stretch", children: [
        SectionTitle(title: "订单已创建"), Gap(size: 12), Label(text: data.orderSummary), Gap(size: 8), SelectableLabel(text: data.orderNo),
        Gap(size: 16), Button(label: "查看订单并支付", icon: "payments", onPressed: event "createdOrder" {}), Button(label: "结束本次兑换", variant: "text", onPressed: event "finishSubmission" {}),
      ])),
      "unavailable": Label(text: "暂时无法读取本机订单记录，请稍后重新进入。"), default: SizedBoxShrink(),
    }, Label(text: data.orderNote, color: "error"),
  ]), default: SizedBoxShrink()},
  switch data.error {"": SizedBoxShrink(), default: EmptyState(icon: "error", title: data.error, action: Button(label: "重试", onPressed: event "retry" {}))},
]);
widget ReviewAction = switch data.ready {true: switch data.nativeOrder {
  true: switch data.orderState {"idle": Button(fullWidth: true, label: "确认兑换", enabled: data.canSubmit, loading: data.orderBusy, onPressed: event "submitOrder" {}), default: SizedBoxShrink()},
  default: switch data.linkProduct {true: Button(label: "查看兑换方式", enabled: data.buy, loading: data.externalBusy, onPressed: event "buy" {}), default: LoginButton()},
}, default: SizedBoxShrink()};
widget SubmissionRecovery = Surface(child: Column(crossAxisAlignment: "stretch", children: [
  SectionTitle(title: "核对上次提交"), Gap(size: 12), Label(text: data.orderSummary), Gap(size: 8),
  Label(text: "尚未确认是否建单。先查询结果，避免重复兑换。"), Gap(size: 16),
  Button(label: "查询提交结果", variant: "tonal", loading: data.orderBusy, onPressed: event "lookupSubmission" {}),
]));

widget BuyerOrders = ListPage(loadingPlaceholder: RowsSkeleton(), loading: data.loading, loadingMore: data.loadingMore, hasMore: data.more,
  onLoadMore: event "ordersMore" {}, error: data.error, onRetry: event "ordersRetry" {}, onRefresh: event "ordersRefresh" {}, emptyTitle: "没有符合条件的订单",
  toolbar: SingleChildScrollView(scrollDirection: "horizontal", primary: false, child: Row(children: [
    ...for filter in data.orderFilters: Padding(padding: [0.0, 0.0, 8.0, 0.0], child: Choice(label: filter.label, selected: filter.selected, onSelected: event "ordersFilter" {status: filter.status, name: filter.name})),
  ])),
  header: BuyerLogin(),
  items: [...for order in data.rows: Surface(padding: [16.0], onTap: event "order" {no: order.no}, child: Column(crossAxisAlignment: "stretch", children: [
    Row(children: [Expanded(child: Label(text: order.seller, style: "labelMedium", color: "onSurfaceVariant")), Label(text: order.state, style: "labelMedium", color: "primary")]), Gap(size: 12),
    ProductSummary(image: order.image, loading: order.imageLoading, title: order.title, subtitle: order.quantity), Gap(size: 12),
    Row(children: [Expanded(child: RelativeTime(value: order.time)), Label(text: order.amount, style: "titleMedium", bold: true), Gap(size: 8), Symbol(name: "chevron_right", size: 18.0)]),
  ]))],
);

widget BuyerOrder = PageLayout(loading: data.loading, onRefresh: event "ordersRefresh" {}, footer: switch data.ready {true: ActionBar(actions: [
  switch data.canCancel {true: Button(label: data.cancelLabel, variant: "text", enabled: data.paymentAvailable, onPressed: event "cancelOrder" {}), default: SizedBoxShrink()},
  switch data.canPay {true: Button(label: "立即支付", icon: "payments", loading: data.paymentBusy, onPressed: event "payOrder" {}), default: switch data.canRepurchase {true: Button(label: "重新兑换", variant: "tonal", onPressed: event "repurchase" {}), default: SizedBoxShrink()}},
]), default: SizedBoxShrink()}, children: [
  switch data.initialLoading {true: ReviewSkeleton(), default: SizedBoxShrink()},
  switch data.ready {true: Column(crossAxisAlignment: "stretch", children: [
