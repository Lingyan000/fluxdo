import fluxdo;

widget BuyerOrders = Column(crossAxisAlignment:"stretch",children:[
  switch data.needsSession {true:SizedBoxShrink(),default:Column(crossAxisAlignment:"stretch",children:[
    Wrap(children:[
      Button(label:"全部",variant:"text",onPressed:event "ordersFilter" {status:"",name:"全部订单"}),
      Button(label:"待支付",variant:"text",onPressed:event "ordersFilter" {status:"pending",name:"待支付订单"}),
      Button(label:"已完成",variant:"text",onPressed:event "ordersFilter" {status:"completed",name:"已完成订单"}),
      IconButton(icon:"refresh",tooltip:"刷新订单",onPressed:event "ordersRefresh" {}),
    ]),
    Label(text:data.filterName,style:"labelMedium"),
  ])},
  switch data.loading {true:Spinner(),default:SizedBoxShrink()},
  switch data.empty {true:Label(text:"没有符合条件的订单"),default:SizedBoxShrink()},
  ...for o in data.rows: Column(crossAxisAlignment:"stretch",children:[
    ListItem(title:o.title,subtitle:o.no,trailing:Column(mainAxisSize:"min",children:[
      Label(text:o.amount,style:"labelMedium"),Label(text:o.state,style:"labelSmall"),
    ]),onTap:event "order" {no:o.no}),Divider(),
  ]),
  switch data.more {true:Button(label:"加载更多订单",variant:"tonal",onPressed:event "ordersMore" {}),default:SizedBoxShrink()},
  OrderFeedback(),
]);

widget BuyerOrder = Column(crossAxisAlignment:"stretch",children:[
  switch data.loading {true:Spinner(),default:SizedBoxShrink()},
  switch data.ready {true:Column(crossAxisAlignment:"stretch",children:[
    Label(text:data.orderTitle,style:"titleLarge"),Gap(size:8),
    Surface(child:Column(crossAxisAlignment:"stretch",children:[
      Label(text:"订单状态",style:"labelMedium"),Label(text:data.state,style:"titleMedium"),
      Gap(size:8),Label(text:"订单积分",style:"labelMedium"),Label(text:data.amount,style:"titleLarge",color:"primary"),
      Gap(size:8),Label(text:"订单号",style:"labelMedium"),Label(text:data.orderNo),
      Gap(size:8),Label(text:"交付方式",style:"labelMedium"),Label(text:data.delivery),
    ])),
    switch data.hasDelivery {true:Column(crossAxisAlignment:"stretch",children:[
      Button(label:data.deliveryAction,icon:"gift",variant:"outlined",onPressed:event "delivery" {}),
      Label(text:data.deliveryText),
    ]),default:SizedBoxShrink()},
    Button(label:"刷新订单",variant:"tonal",onPressed:event "ordersRefresh" {}),
  ]),default:SizedBoxShrink()},
  OrderFeedback(),
]);

widget OrderFeedback = switch data.error {
  "":SizedBoxShrink(),
  default:Column(crossAxisAlignment:"stretch",children:[
    Label(text:data.error),
    switch data.needsSession {true:Button(label:"在士多官网查看订单",icon:"open_in_new",variant:"outlined",onPressed:event "officialOrders" {}),
      default:Button(label:"重新读取订单",variant:"outlined",onPressed:event "ordersRefresh" {})},
  ])
};

widget Card = Column(crossAxisAlignment:"stretch",children: [
  Button(label: "进入物品广场", icon: "storefront", onPressed: event "market" {}),
  Wrap(children:[
    Button(label: "在士多官网登录", icon:"open_in_new",variant: "text", onPressed: event "login" {}),
    Button(label: "我的订单",icon:"history",variant: "text", onPressed: event "orders" {}),
  ]),
]);

widget Market = Column(crossAxisAlignment: "stretch", children: [
  Row(children:[
    Expanded(child: TextInput(label: "搜索商品", onChanged: event "input" {field: "search"}, onSubmitted: event "apply" {})),
    IconButton(icon:"search",tooltip:"搜索商品",onPressed:event "apply" {}),
  ]),
  Wrap(children:[
    Button(label:data.filterLabel,icon:"settings",variant:"tonal",onPressed:event "filters" {}),
    IconButton(icon:"refresh",tooltip:"刷新",onPressed:event "refresh" {}),
    Button(label:"我的订单",icon:"history",variant:"text",onPressed:event "orders" {}),
  ]),
  switch data.filters {true: Surface(child: Column(crossAxisAlignment:"stretch",children:[
  Label(text:"商品分类",style:"titleSmall"),
  Wrap(children: [
    ...for c in data.categories: Button(label: c.name, variant: c.variant, onPressed: event "select" {cat: c.id, label: c.name}),
  ]),
  Label(text: data.categoryMessage),
  Label(text:"排序",style:"titleSmall"),
  Wrap(children: [
    ...for o in data.sorts: Button(label:o.label,variant:o.variant,onPressed:event "select" {sort:o.sort,direction:o.direction,label:o.label}),
  ]),
  Row(children: [
    Expanded(child: TextInput(value:data.min,label: "最低价", onChanged: event "input" {field:"min"})),
    Gap(size:8),
    Expanded(child: TextInput(value:data.max,label: "最高价", onChanged: event "input" {field:"max"})),
  ]),
  Row(children:[Toggle(value:data.stock,onChanged:event "stock" {}), Label(text:"仅有库存")]),
  Button(label:"应用价格筛选",onPressed:event "apply" {}),
  ])),default:SizedBoxShrink()},
  Gap(size:8),Label(text:data.selection,style:"labelMedium"),
  Label(text:data.message),
  switch data.webFallback {true: Button(label:"在网页中浏览士多",onPressed:event "webMarket" {}), default:SizedBoxShrink()},
  ...for item in data.rows: Column(crossAxisAlignment:"stretch",children:[
    ListItem(title:item.title, subtitle:item.info, leading: Image(url:item.image,width:48,height:48,radius:8),
      trailing:Symbol(name:"chevron_right"),onTap:event "product" {id:item.id}),
    Divider(),
  ]),
  switch data.loading {true: Spinner(), default: SizedBoxShrink()},
  switch data.more {true: Button(label:"加载更多",onPressed:event "more" {}), default:SizedBoxShrink()},
]);

widget Product = Column(crossAxisAlignment:"stretch",children:[
  switch data.loading {true: Spinner(), default: SizedBoxShrink()},
  switch data.ready {
    true: Column(crossAxisAlignment:"stretch",children:[
      switch data.image {"":SizedBoxShrink(),default:Image(url:data.image,height:180,fit:"contain")},
      Gap(size:8),Label(text:data.title,style:"titleLarge",bold:true),
      Label(text:data.price,style:"titleMedium",color:"primary"),Gap(size:12),
      Surface(child:Column(crossAxisAlignment:"stretch",children:[
        Label(text:data.details),Label(text:data.seller),Label(text:data.conditions),
      ])),
      Gap(size:12),Label(text:"商品说明",style:"titleMedium"),Label(text:data.description),
      Gap(size:12),Button(label:"查看兑换预览",enabled:data.buy,onPressed:event "review" {}),
    ]),
    default: SizedBoxShrink(),
  },
  switch data.error {"": SizedBoxShrink(), default: Column(children:[
    Label(text:data.error,color:"error"),Button(label:"重试",onPressed:event "retry" {}),
    Button(label:"在网页中查看商品",onPressed:event "webProduct" {}),
  ])},
]);

widget Review = Column(crossAxisAlignment:"stretch",children:[
  switch data.loading {true:Spinner(),default:SizedBoxShrink()},
  switch data.ready {true:Column(crossAxisAlignment:"stretch",children:[
    Label(text:data.title,style:"titleLarge",bold:true),Label(text:data.seller),
    Gap(size:12),Surface(child:Column(crossAxisAlignment:"stretch",children:[
      Label(text:"商品单价",style:"labelMedium"),Label(text:data.price,style:"titleMedium"),
      Label(text:data.details),Label(text:data.conditions),Divider(),
      Label(text:"预估数量"),Wrap(children:[
        Button(label:"−",variant:"outlined",enabled:data.canRemove,onPressed:event "quantity" {step:-1}),
        Chip(label:data.quantity),
        Button(label:"+",variant:"outlined",enabled:data.canAdd,onPressed:event "quantity" {step:1}),
      ]),
      Label(text:"商品小计（未计优惠）",style:"labelMedium"),
      Label(text:data.estimate,style:"titleLarge",color:"primary"),
    ])),
    switch data.canQuote {true:Button(label:"查询当前报价",loading:data.quoting,variant:"tonal",onPressed:event "quote" {}),default:SizedBoxShrink()},
    switch data.quoteReady {true:Surface(child:Column(crossAxisAlignment:"stretch",children:[
      Label(text:"报价应付",style:"labelMedium"),Label(text:data.payable,style:"titleLarge",color:"primary"),Label(text:data.choice),
      Gap(size:8),Label(text:"优惠券 · 选项中显示券后应付",style:"labelMedium"),
      Wrap(children:[...for c in data.couponRows: Button(label:c.label,variant:c.variant,onPressed:event "quoteCoupon" {id:c.id}),
        Button(label:"不使用优惠券",variant:data.noneVariant,onPressed:event "quoteCoupon" {id:""})]),
    ])),default:SizedBoxShrink()},
    switch data.quoteNote {"":SizedBoxShrink(),default:Label(text:data.quoteNote)},
    Gap(size:12),switch data.nativeOrder {
      true:switch data.orderState {"idle":Button(label:"核对并创建订单",enabled:data.canSubmit,loading:data.orderBusy,onPressed:event "submitOrder" {}),default:SizedBoxShrink()},
      default:Column(crossAxisAlignment:"stretch",children:[
        Label(text:"此页不会下单。实际数量、优惠和应付积分请在士多结算时确认。"),
        Button(label:"前往士多确认兑换",icon:"open_in_new",enabled:data.buy,onPressed:event "buy" {}),
      ]),
    },
  ]),default:SizedBoxShrink()},
  switch data.nativeOrder {true:Column(crossAxisAlignment:"stretch",children:[
    switch data.orderState {
      "pending":SubmissionRecovery(),
      "missing":Column(crossAxisAlignment:"stretch",children:[
        SubmissionRecovery(),
        Button(label:"用原提交号重试",variant:"outlined",loading:data.orderBusy,onPressed:event "retrySubmission" {}),
      ]),
      "created":Surface(child:Column(crossAxisAlignment:"stretch",children:[
        Label(text:"订单已创建",style:"titleMedium"),Label(text:data.orderSummary),Label(text:data.orderNo),
        Button(label:"查看已建订单",onPressed:event "createdOrder" {}),
        Button(label:"结束本次兑换",variant:"text",onPressed:event "finishSubmission" {}),
      ])),
      "unavailable":Label(text:"暂时无法读取本机订单记录，请稍后重新进入。"),
      default:SizedBoxShrink(),
    },
    Label(text:data.orderNote),
  ]),default:SizedBoxShrink()},
  switch data.error {"":SizedBoxShrink(),default:Column(children:[
    Label(text:data.error,color:"error"),Button(label:"重试",onPressed:event "retry" {}),
  ])},
]);

widget SubmissionRecovery = Surface(child:Column(crossAxisAlignment:"stretch",children:[
  Label(text:"核对上次提交",style:"titleMedium"),Label(text:data.orderSummary),
  switch data.orderState {"missing":Label(text:"士多尚未查到这笔订单。重试仍使用原订单信息和提交号。"),
    default:Label(text:"尚未确认是否建单。先查询结果，避免重复兑换。")},
  Button(label:"查询提交结果",variant:"tonal",loading:data.orderBusy,onPressed:event "lookupSubmission" {}),
]));
