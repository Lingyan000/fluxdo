import fluxdo;

widget Card = Column(crossAxisAlignment: "stretch", children: [
  Row(children: [
    Expanded(child: Button(label: "物品广场", icon: "storefront", variant: "tonal", onPressed: event "market" {})),
    Gap(size: 8),
    Expanded(child: Button(label: "我的订单", icon: "history", variant: "tonal", onPressed: event "orders" {})),
  ]),
  Gap(size: 8),
  Row(children: [
    Expanded(child: Button(label: "我的收藏", icon: "favorite", variant: "text", onPressed: event "favorites" {})),
    Expanded(child: Button(label: "优惠券", icon: "gift", variant: "text", onPressed: event "coupons" {})),
  ]),
  LoginButton(),
]);

widget Market = GridPage(
  layout: "equalHeight",
  hasMore: data.more, loadingMore: data.loadingMore,
  onLoadMore: event "more" {}, loading: data.loading,
  error: data.message, emptyTitle: "没有符合条件的商品",
  onRefresh: event "refresh" {}, onRetry: event "marketRetry" {},
  header: Column(crossAxisAlignment: "stretch", children: [
    SearchInput(hint: "搜索商品", onChanged: event "input" {field: "search"}, onSubmitted: event "apply" {}),
    Gap(size: 12),
    Row(children: [
      Button(label: data.filterLabel, icon: "settings", variant: "tonal", onPressed: event "filters" {}),
      Spacer(),
      Button(label: "我的订单", icon: "history", variant: "text", onPressed: event "orders" {}),
    ]),
    switch data.filters {
      true: Padding(padding: [0.0, 12.0, 0.0, 0.0], child: Surface(child: Column(crossAxisAlignment: "stretch", children: [
        Label(text: "商品分类", style: "titleSmall"),
        Gap(size: 8),
        Wrap(spacing: 8.0, runSpacing: 4.0, children: [
          ...for c in data.categories: Choice(label: c.name, selected: c.selected, onSelected: event "select" {cat: c.id, label: c.name}),
        ]),
        switch data.categoryMessage {"": SizedBoxShrink(), default: Label(text: data.categoryMessage, color: "error")},
        Gap(size: 16),
        Label(text: "排序", style: "titleSmall"),
        Gap(size: 8),
        Wrap(spacing: 8.0, runSpacing: 4.0, children: [
          ...for o in data.sorts: Choice(label: o.label, selected: o.selected, onSelected: event "select" {sort: o.sort, direction: o.direction, label: o.label}),
        ]),
        Gap(size: 16),
        Row(children: [
          Expanded(child: TextInput(value: data.min, label: "最低价", onChanged: event "input" {field: "min"})),
          Gap(size: 12),
          Expanded(child: TextInput(value: data.max, label: "最高价", onChanged: event "input" {field: "max"})),
        ]),
        Gap(size: 8),
        Row(children: [Expanded(child: Label(text: "仅有库存")), Toggle(value: data.stock, onChanged: event "stock" {})]),
        Gap(size: 8),
        Button(label: "应用价格筛选", onPressed: event "apply" {}),
      ]))),
      default: SizedBoxShrink(),
    },
    Gap(size: 20),
    Label(text: data.selection, style: "labelMedium", color: "onSurfaceVariant"),
    Gap(size: 12),

  ]),
  actions: switch data.webFallback {true: Button(label: "在网页中浏览士多", variant: "tonal", onPressed: event "webMarket" {}), default: SizedBoxShrink()},
  items: [...for item in data.rows: ProductTile(item: item)],
);

widget ProductTile = Surface(padding: [0.0], onTap: event "product" {id: args.item.id}, child: Column(crossAxisAlignment: "stretch", children: [
  AspectRatio(aspectRatio: 1.25, child: Image(url: args.item.image, fit: "cover")),
  Padding(padding: [12.0], child: Column(crossAxisAlignment: "stretch", children: [
    Label(text: args.item.title, style: "titleSmall", maxLines: 2), Gap(size: 8),
    Label(text: args.item.price, style: "titleMedium", color: "primary", bold: true), Gap(size: 4),
    Label(text: args.item.stock, style: "labelSmall", color: "onSurfaceVariant"),
  ])),
]));

widget Product = PageLayout(
  hasMore: data.commentsMore,
  loadingMore: data.commentsLoading,
  loadMoreError: data.commentsError,
  onLoadMore: event "commentsMore" {},
  loading: data.loading,
  onRefresh: event "retry" {},
  footer: switch data.ready {
    true: Column(mainAxisSize: "min", crossAxisAlignment: "stretch", children: [
      ExternalFeedback(),
      Row(children: [
        Expanded(child: Label(text: data.price, style: "titleLarge", color: "primary", bold: true)),
        Gap(size: 12),
        switch data.linkProduct {
          true: Button(label: "查看兑换方式", icon: "open_in_new", enabled: data.buy, loading: data.externalBusy, onPressed: event "buy" {}),
          default: Button(label: "立即兑换", enabled: data.buy, onPressed: event "review" {}),
        },
      ]),
    ]),
    default: SizedBoxShrink(),
  },
  children: [
    switch data.loading {true: Padding(padding: [32.0], child: Spinner()), default: SizedBoxShrink()},
    switch data.ready {
      true: Column(crossAxisAlignment: "stretch", children: [
        switch data.image {
          "": SizedBoxShrink(),
          default: Surface(padding: [0.0], child: AspectRatio(aspectRatio: 1.5, child: Image(url: data.image, fit: "contain"))),
        },
        Gap(size: 20),
        Label(text: data.title, style: "titleLarge", bold: true),
        Gap(size: 8),
        Label(text: data.seller, color: "onSurfaceVariant"),
        Wrap(spacing: 8.0, runSpacing: 8.0, children: [
          Button(label: data.favoriteLabel, icon: "favorite", variant: "text", loading: data.buyerBusy, onPressed: event "favorite" {}),
          Button(label: "我的收藏", variant: "text", onPressed: event "favorites" {}),
        ]),
        BuyerFeedback(),
        Gap(size: 20),
        Surface(child: Column(crossAxisAlignment: "stretch", children: [
          Label(text: data.details),
          Gap(size: 8),
          Label(text: data.conditions, color: "onSurfaceVariant"),
        ])),
        Gap(size: 24),
        Label(text: "商品说明", style: "titleMedium"),
        Gap(size: 12),
        SelectableLabel(text: data.description),
        Gap(size: 24),
        Row(children: [Expanded(child: Label(text: "商品评论", style: "titleMedium")),
          switch data.canComment {true: Button(label: "写评论", icon: "edit", variant: "text", onPressed: event "comment" {}), default: SizedBoxShrink()},
        ]),
        Gap(size: 12),
        ...for comment in data.comments: Padding(padding: [0.0, 0.0, 0.0, 16.0], child: Column(crossAxisAlignment: "stretch", children: [
          Row(children: [
            Expanded(child: Label(text: comment.author, bold: true)),
            Label(text: comment.rating, color: "onSurfaceVariant"),
          ]),
          Gap(size: 8),
          SelectableLabel(text: comment.content),
        ])),
        Label(text: data.commentsMessage, color: "onSurfaceVariant"),
        switch data.commentsLoading {true: Spinner(), default: SizedBoxShrink()},
        switch data.commentsError {
          "": SizedBoxShrink(),
          default: Column(children: [
            Label(text: data.commentsError, color: "error"),
            Button(label: "重新加载评论", variant: "text", onPressed: event "commentsRetry" {}),
          ]),
        },
        switch data.commentsMore {true: Button(label: "更多评论", variant: "text", onPressed: event "commentsMore" {}), default: SizedBoxShrink()},
      ]),
      default: SizedBoxShrink(),
    },
    switch data.error {
      "": SizedBoxShrink(),
      default: EmptyState(icon: "error", title: data.error, action: Column(mainAxisSize: "min", children: [
        Button(label: "重试", onPressed: event "retry" {}),
        Button(label: "在网页中查看商品", variant: "text", onPressed: event "webProduct" {}),
      ])),
    },
  ],
);

widget Review = PageLayout(
  loading: data.loading,
  onRefresh: event "retry" {},
  footer: ReviewAction(),
  children: [
    switch data.loading {true: Padding(padding: [32.0], child: Spinner()), default: SizedBoxShrink()},
    switch data.ready {
      true: Column(crossAxisAlignment: "stretch", children: [
        Surface(child: Column(crossAxisAlignment: "stretch", children: [
          Label(text: data.title, style: "titleMedium", bold: true),
          Gap(size: 8),
          Label(text: data.seller, color: "onSurfaceVariant"),
          Gap(size: 16),
          DetailRow(label: "单价", value: data.price),
          Gap(size: 8),
          Label(text: data.conditions, style: "bodySmall", color: "onSurfaceVariant"),
          Gap(size: 16),
          Row(children: [
            Expanded(child: Label(text: "数量")),
            Button(label: "−", variant: "outlined", enabled: data.canRemove, onPressed: event "quantity" {step: -1}),
            Padding(padding: [12.0, 0.0, 12.0, 0.0], child: Label(text: data.quantity, style: "titleMedium")),
            Button(label: "+", variant: "outlined", enabled: data.canAdd, onPressed: event "quantity" {step: 1}),
          ]),
          Gap(size: 16),
          DetailRow(label: "商品小计", value: data.estimate),
        ])),
        Gap(size: 20),
        switch data.quoting {true: Spinner(), default: SizedBoxShrink()},
        switch data.quoteReady {
          true: Surface(child: Column(crossAxisAlignment: "stretch", children: [
            Label(text: "优惠券", style: "titleMedium"),
            Gap(size: 8),
            Label(text: "选项中显示券后应付", style: "bodySmall", color: "onSurfaceVariant"),
            Gap(size: 8),
            Wrap(spacing: 8.0, runSpacing: 8.0, children: [
              ...for c in data.couponRows: Choice(label: c.label, selected: c.selected, onSelected: event "quoteCoupon" {id: c.id}),
              Choice(label: "不使用优惠券", selected: data.noCoupon, onSelected: event "quoteCoupon" {id: ""}),
            ]),
            Gap(size: 16),
            DetailRow(label: "应付积分", value: data.payable),
          ])),
          default: SizedBoxShrink(),
        },
        switch data.canQuote {true: Button(label: "刷新报价", loading: data.quoting, variant: "text", onPressed: event "quote" {}), default: SizedBoxShrink()},
        switch data.quoteNote {"": SizedBoxShrink(), default: Label(text: data.quoteNote, color: "error")},
      ]),
      default: SizedBoxShrink(),
    },
    switch data.nativeOrder {
      true: Column(crossAxisAlignment: "stretch", children: [
        switch data.orderState {
          "pending": SubmissionRecovery(),
          "missing": Column(crossAxisAlignment: "stretch", children: [
            SubmissionRecovery(),
            Gap(size: 8),
            Button(label: "用原提交号重试", variant: "outlined", loading: data.orderBusy, onPressed: event "retrySubmission" {}),
          ]),
          "created": Surface(child: Column(crossAxisAlignment: "stretch", children: [
            Label(text: "订单已创建", style: "titleMedium"),
            Gap(size: 12),
            Label(text: data.orderSummary),
            Gap(size: 8),
            SelectableLabel(text: data.orderNo),
            Gap(size: 16),
            Button(label: "查看订单并支付", icon: "payments", onPressed: event "createdOrder" {}),
            Button(label: "结束本次兑换", variant: "text", onPressed: event "finishSubmission" {}),
          ])),
          "unavailable": Label(text: "暂时无法读取本机订单记录，请稍后重新进入。"),
          default: SizedBoxShrink(),
        },
        switch data.orderNote {"": SizedBoxShrink(), default: Label(text: data.orderNote)},
      ]),
      default: SizedBoxShrink(),
    },
    switch data.error {"": SizedBoxShrink(), default: EmptyState(icon: "error", title: data.error, action: Button(label: "重试", onPressed: event "retry" {}))},
  ],
);

widget ReviewAction = switch data.ready {
  true: switch data.nativeOrder {
    true: switch data.orderState {
      "idle": Button(label: "核对并创建订单", enabled: data.canSubmit, loading: data.orderBusy, onPressed: event "submitOrder" {}),
      default: SizedBoxShrink(),
    },
    default: switch data.linkProduct {
      true: Column(mainAxisSize: "min", crossAxisAlignment: "stretch", children: [
        ExternalFeedback(),
        Button(label: "查看兑换方式", icon: "open_in_new", enabled: data.buy, loading: data.externalBusy, onPressed: event "buy" {}),
      ]),
      default: LoginButton(),
    },
  },
  default: SizedBoxShrink(),
};

widget ExternalFeedback = switch data.externalError {
  "": SizedBoxShrink(),
  default: Padding(padding: [0.0, 0.0, 0.0, 8.0], child: Label(text: data.externalError, color: "error")),
};

widget BuyerOrders = PageLayout(hasMore: data.more, onLoadMore: event "ordersMore" {}, loadMoreError: data.error, loading: data.loading, onRefresh: event "ordersRefresh" {}, children: [
  switch data.needsSession {
    true: SizedBoxShrink(),
    default: Wrap(spacing: 8.0, runSpacing: 8.0, children: [
      ...for filter in data.orderFilters: Choice(label: filter.label, selected: filter.selected, onSelected: event "ordersFilter" {status: filter.status, name: filter.name}),
    ]),
  },
  Gap(size: 16),
  switch data.loading {true: Padding(padding: [24.0], child: Spinner()), default: SizedBoxShrink()},
  switch data.empty {true: EmptyState(icon: "history", title: "没有符合条件的订单"), default: SizedBoxShrink()},
  ...for order in data.rows: Padding(padding: [0.0, 0.0, 0.0, 12.0], child: Surface(onTap: event "order" {no: order.no}, child: Column(crossAxisAlignment: "stretch", children: [
    Row(children: [
      Expanded(child: Label(text: order.title, style: "titleMedium", maxLines: 2)),
      Gap(size: 12),
      Label(text: order.state, style: "labelMedium", color: "primary"),
    ]),
    Gap(size: 12),
    Label(text: order.no, style: "bodySmall", color: "onSurfaceVariant", maxLines: 1),
    Gap(size: 12),
    Row(children: [
      Expanded(child: Label(text: order.amount, style: "titleMedium", bold: true)),
      Symbol(name: "chevron_right"),
    ]),
  ]))),
  switch data.more {true: Button(label: "加载更多订单", variant: "tonal", onPressed: event "ordersMore" {}), default: SizedBoxShrink()},
  OrderFeedback(),
]);

widget BuyerOrder = PageLayout(
  loading: data.loading,
  onRefresh: event "ordersRefresh" {},
  footer: switch data.ready {
    true: switch data.canPay {
      true: Row(children: [
        Expanded(child: Button(label: data.cancelLabel, variant: "text", enabled: data.paymentAvailable, onPressed: event "cancelOrder" {})),
        Gap(size: 12),
        Expanded(child: Button(label: "立即支付", icon: "payments", loading: data.paymentBusy, onPressed: event "payOrder" {})),
      ]),
      default: SizedBoxShrink(),
    },
    default: SizedBoxShrink(),
  },
  children: [
    switch data.loading {true: Padding(padding: [32.0], child: Spinner()), default: SizedBoxShrink()},
    switch data.ready {
      true: Column(crossAxisAlignment: "stretch", children: [
        Gap(size: 8),
        Label(text: data.state, style: "titleMedium", align: "center", color: "primary"),
        Gap(size: 12),
        Label(text: data.amount, style: "headlineMedium", align: "center", bold: true),
        Gap(size: 24),
        Surface(child: Column(crossAxisAlignment: "stretch", children: [
          Label(text: data.orderTitle, style: "titleMedium", bold: true),
          Gap(size: 20),
          DetailRow(label: "交付方式", value: data.delivery),
          Gap(size: 16),
          Label(text: "订单号", style: "labelMedium", color: "onSurfaceVariant"),
          Gap(size: 4),
          SelectableLabel(text: data.orderNo),
        ])),
        switch data.hasDelivery {
          true: Padding(padding: [0.0, 16.0, 0.0, 0.0], child: Surface(child: Column(crossAxisAlignment: "stretch", children: [
            Button(label: data.deliveryAction, icon: "gift", variant: "tonal", onPressed: event "delivery" {}),
            switch data.deliveryText {"": SizedBoxShrink(), default: Padding(padding: [0.0, 12.0, 0.0, 0.0], child: SelectableLabel(text: data.deliveryText))},
          ]))),
          default: SizedBoxShrink(),
        },
        Gap(size: 20),
        switch data.paymentNote {"": SizedBoxShrink(), default: Label(text: data.paymentNote, color: "error")},
        Button(label: "退款与售后", icon: "history", variant: "tonal", onPressed: event "refund" {}),
        Gap(size: 8),
        Button(label: "刷新订单", icon: "refresh", variant: "text", onPressed: event "ordersRefresh" {}),
      ]),
      default: SizedBoxShrink(),
    },
    OrderFeedback(),
  ],
);

widget DetailRow = Row(crossAxisAlignment: "start", children: [
  Label(text: args.label, color: "onSurfaceVariant"),
  Gap(size: 20),
  Expanded(child: Label(text: args.value, align: "end", style: "titleSmall")),
]);

widget OrderFeedback = switch data.error {
  "": SizedBoxShrink(),
  default: EmptyState(icon: "history", title: data.error, action: switch data.needsSession {
    true: LoginButton(),
    default: Button(label: "重新读取订单", variant: "outlined", onPressed: event "ordersRefresh" {}),
  }),
};

widget SubmissionRecovery = Surface(child: Column(crossAxisAlignment: "stretch", children: [
  Label(text: "核对上次提交", style: "titleMedium"),
  Gap(size: 12),
  Label(text: data.orderSummary),
  Gap(size: 8),
  switch data.orderState {
    "missing": Label(text: "士多尚未查到这笔订单。重试仍使用原订单信息和提交号。"),
    default: Label(text: "尚未确认是否建单。先查询结果，避免重复兑换。"),
  },
  Gap(size: 16),
  Button(label: "查询提交结果", variant: "tonal", loading: data.orderBusy, onPressed: event "lookupSubmission" {}),
]));

widget LoginButton = switch data.authorized {
  true: SizedBoxShrink(),
  default: Column(mainAxisSize: "min", crossAxisAlignment: "stretch", children: [
    Button(label: "登录士多", icon: "person", variant: "text", loading: data.loggingIn, onPressed: event "login" {}),
    switch data.loginError {"": SizedBoxShrink(), default: Padding(padding: [0.0, 8.0, 0.0, 0.0], child: Label(text: data.loginError, style: "bodySmall", color: "error"))},
  ]),
};


widget BuyerFeedback = switch data.buyerError {
  "": SizedBoxShrink(), default: Padding(padding: [0.0, 12.0, 0.0, 12.0], child: Label(text: data.buyerError, color: "error")),
};
widget BuyerLogin = switch data.needsSession {true: LoginButton(), default: SizedBoxShrink()};

widget Favorites = GridPage(layout: "equalHeight", loading: data.loading, loadingMore: data.loadingMore,
  hasMore: data.more, error: data.error, emptyTitle: "还没有收藏商品",
  onRefresh: event "buyerRefresh" {}, onRetry: event "buyerRetry" {}, onLoadMore: event "buyerMore" {},
  header: Column(crossAxisAlignment: "stretch", children: [
    SearchInput(hint: "搜索收藏的商品", onChanged: event "favoriteSearch" {}, onSubmitted: event "buyerRefresh" {}),
    BuyerLogin(),
  ]),
  items: [...for item in data.rows: ProductTile(item: item)],
);

widget Coupons = ListPage(loading: data.loading, loadingMore: data.loadingMore, hasMore: data.more,
  error: data.error, emptyTitle: "暂无此类优惠券", onRefresh: event "buyerRefresh" {},
  onRetry: event "buyerRetry" {}, onLoadMore: event "buyerMore" {},
  header: Column(crossAxisAlignment: "stretch", children: [
    Wrap(spacing: 8.0, runSpacing: 8.0, children: [...for tab in data.tabs: Choice(label: tab.label, selected: tab.selected, onSelected: event "couponTab" {value: tab.value})]),
    BuyerLogin(),
  ]),
  items: [...for coupon in data.rows: Padding(padding: [16.0], child: Column(crossAxisAlignment: "stretch", children: [
    CouponInfo(coupon: coupon),
    Gap(size: 16),
    Button(label: coupon.action, variant: "tonal", onPressed: event "couponUse" {id: coupon.id}),
  ]))],
);
widget CouponInfo = Column(crossAxisAlignment: "stretch", children: [
  Label(text: args.coupon.title, style: "titleMedium", bold: true), Gap(size: 8),
  Label(text: args.coupon.rule, style: "titleLarge", color: "primary", bold: true), Gap(size: 8),
  Label(text: args.coupon.seller, color: "onSurfaceVariant"), Gap(size: 16),
  DetailRow(label: "适用范围", value: args.coupon.scope), Gap(size: 8),
  DetailRow(label: "使用门槛", value: args.coupon.minimum), Gap(size: 8),
  DetailRow(label: "到期时间", value: args.coupon.expires),
  switch args.coupon.state {"": SizedBoxShrink(), default: Padding(padding: [0.0, 12.0, 0.0, 0.0], child: Label(text: args.coupon.state, color: "primary"))},
]);
widget Coupon = PageLayout(loading: data.loading, onRefresh: event "buyerRefresh" {},
  footer: switch data.ready {
    true: Column(mainAxisSize: "min", crossAxisAlignment: "stretch", children: [BuyerFeedback(),
      switch data.claimed {
        true: Button(label: "查看我的优惠券", icon: "check_circle", onPressed: event "coupons" {}),
        default: switch data.authorized {
          true: Button(label: data.claimLabel, enabled: data.canClaim, loading: data.buyerBusy, onPressed: event "claimCoupon" {}),
          default: LoginButton(),
        },
      },
    ]), default: SizedBoxShrink(),
  },
  children: [
    switch data.loading {true: Spinner(), default: SizedBoxShrink()},
    switch data.ready {true: Surface(child: Column(crossAxisAlignment: "stretch", children: [
      Symbol(name: "gift", size: 48.0), Gap(size: 20), CouponInfo(coupon: data.coupon), Gap(size: 16),
      Label(text: data.description), Gap(size: 12), DetailRow(label: "生效时间", value: data.coupon.starts),
    ])), default: SizedBoxShrink()},
    switch data.error {"": SizedBoxShrink(), default: EmptyState(title: data.error, action: Button(label: "重试", onPressed: event "buyerRefresh" {}))},
  ],
);

widget CommentForm = switch data.commentSubmitted {
  true: DetailPage(sections: [EmptyState(icon: "check_circle", title: data.commentResult)]),
  default: switch data.canComment {
    true: FormPage(loading: data.buyerBusy, submitLabel: "提交评论", fields: data.fields,
      header: Column(crossAxisAlignment: "stretch", children: [Label(text: "评论将公开展示，请勿填写订单密码或其他敏感信息。", color: "onSurfaceVariant"), BuyerFeedback()]),
      onSubmit: event "postComment" {}),
    default: DetailPage(loading: data.loading, error: data.error, onRetry: event "buyerRetry" {}, sections: [BuyerLogin()]),
  },
};
widget RefundSummary = Column(crossAxisAlignment: "stretch", children: [
  Label(text: data.refundState, style: "titleLarge", bold: true, color: "primary"), Gap(size: 12),
  switch data.refundAmount {"": SizedBoxShrink(), default: Label(text: data.refundAmount, style: "headlineSmall")},
  Label(text: data.refundMessage), Gap(size: 8),
  switch data.deadline {"": SizedBoxShrink(), default: Label(text: data.deadline, style: "bodySmall", color: "onSurfaceVariant")},
  BuyerFeedback(),
]);
widget Refund = switch data.canApply {
  true: FormPage(loading: data.buyerBusy, submitLabel: "申请退款", fields: data.refundFields,
    header: RefundSummary(), onSubmit: event "applyRefund" {}),
  default: DetailPage(loading: data.loading, error: data.error, onRetry: event "buyerRetry" {},
    onRefresh: event "buyerRefresh" {},
    actions: ActionBar(actions: [
      switch data.hasGuide {true: Button(label: "争议处理说明", variant: "text", onPressed: event "refundGuide" {}), default: SizedBoxShrink()},
      Button(label: "刷新进度", variant: "tonal", onPressed: event "buyerRefresh" {}),
    ]),
    sections: [BuyerLogin(), RefundSummary(),
      SelectableLabel(text: data.reason),
      ...for entry in data.events: Surface(child: Column(crossAxisAlignment: "stretch", children: [
        Label(text: entry.title, style: "titleSmall", bold: true), Gap(size: 8),
        Label(text: entry.message), Gap(size: 8),
        Label(text: entry.time, style: "bodySmall", color: "onSurfaceVariant"),
      ])),
    ],
  ),
};

widget Merchant = GridPage(layout: "equalHeight", loading: data.loading, loadingMore: data.loadingMore,
  hasMore: data.more, error: data.error, emptyTitle: "暂无在售商品",
  onRefresh: event "buyerRefresh" {}, onRetry: event "buyerRetry" {}, onLoadMore: event "buyerMore" {},
  header: Label(text: data.merchantTitle, style: "titleMedium"),
  items: [...for item in data.rows: ProductTile(item: item)],
);
