  toolbar: Column(crossAxisAlignment: "stretch", children: [SearchInput(value: data.search, hint: data.collectionHint, onChanged: event "favoriteSearch" {}, onSubmitted: event "buyerRefresh" {}), Gap(size: 8), Wrap(spacing: 8.0, children: [...for tab in data.collections: Choice(label: tab.label, selected: tab.selected, onSelected: event "collectionTab" {id: tab.id})])]), header: Column(children: [BuyerLogin(), BuyerFeedback()]),
