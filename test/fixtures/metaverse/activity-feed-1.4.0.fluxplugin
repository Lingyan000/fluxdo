{"manifest":{"schema":12,"apiVersion":2,"id":"community.fluxdo.activity","version":"1.4.0","name":"动态订阅","author":"FluxDO 社区","description":"按名单聚合论坛动态，保留最近记录并提醒未读。","icon":"history","ui":"ui.rfwtxt","script":"main.js","requiredFeatures":["forumRead","navigationEntries","navigationBadge","scheduledTasks","localNotifications","atomicStorage","runtimePermissions","adaptiveCollections","modalDismiss","cardNavigation","contentPresentation","notificationStatus","hostEnvironment","pageChrome","manifestLocalization","storageScopes"],"permissions":{"network":[],"forum":["profiles","following","activity"],"identity":true,"background":true,"notifications":true},"tasks":[{"id":"refresh","title":"更新订阅动态"}],"card":{"widget":"Card","page":"feed"},"pages":[{"id":"feed","title":"动态订阅","widget":"Feed","scroll":false,"navigation":{"label":"订阅","icon":"history"},"appBar":{"title":"LocalizedTitle"}},{"id":"settings","title":"订阅管理","widget":"Settings","scroll":false,"appBar":{"title":"LocalizedTitle"}},{"id":"add","title":"添加订阅","widget":"AddPerson","presentation":"modal","scroll":false,"appBar":{"title":"LocalizedTitle"}},{"id":"following","title":"从关注中选择","widget":"Following","presentation":"modal","scroll":false,"appBar":{"title":"LocalizedTitle"}},{"id":"bulk","title":"批量导入订阅","widget":"BulkImport","presentation":"modal","scroll":false,"appBar":{"title":"LocalizedTitle"}}],"locales":{"en":{"name":"Activity feed","description":"Follow selected members, keep recent activity and see unread updates.","pages.feed.title":"Activity feed","pages.feed.navigation.label":"Following","pages.settings.title":"Manage subscriptions","pages.add.title":"Add subscription","pages.following.title":"Choose from following","pages.bulk.title":"Import subscriptions","tasks.refresh.title":"Update activity feed"},"zh_TW":{"name":"動態訂閱","description":"按名單聚合論壇動態，保留最近記錄並提醒未讀。","pages.feed.title":"動態訂閱","pages.feed.navigation.label":"訂閱","pages.settings.title":"訂閱管理","pages.add.title":"新增訂閱","pages.following.title